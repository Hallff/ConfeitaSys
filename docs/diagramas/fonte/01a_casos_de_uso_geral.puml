@startuml
!include _estilo.iuml
title Diagrama de Casos de Uso - Visão Geral do ConfeitaSys
left to right direction
skinparam packageStyle rectangle
actor "Usuário\n(Dono / Gerente)" as U
actor "Relógio do sistema\n(a cada 20 s)" as T
  package "Acesso" {
    usecase "UC01 Cadastrar usuário (1º acesso)" as UC01
    usecase "UC02 Fazer login" as UC02
    usecase "UC03 Sair do sistema" as UC03
  }
  package "Cadastro 1 - Usuário" {
    usecase "UC04 Consultar usuário" as UC04
    usecase "UC05 Alterar nome / senha" as UC05
    usecase "UC06 Excluir usuário" as UC06
  }
  package "Cadastro 2 - Estoque" {
    usecase "UC07 Incluir ingrediente" as UC07
    usecase "UC08 Consultar estoque" as UC08
    usecase "UC09 Alterar ingrediente" as UC09
    usecase "UC10 Excluir ingrediente" as UC10
  }
  package "Cadastro 3 - Produtos" {
    usecase "UC11 Incluir produto c/ receita" as UC11
    usecase "UC12 Consultar produtos" as UC12
    usecase "UC13 Alterar produto" as UC13
    usecase "UC14 Excluir produto" as UC14
  }
  package "Vendas" {
    usecase "UC15 Registrar venda" as UC15
    usecase "UC16 Pesquisar venda" as UC16
    usecase "UC17 Ver ingredientes da venda" as UC17
    usecase "UC18 Editar venda" as UC18
    usecase "UC19 Excluir venda / devolução" as UC19
  }
  package "Alertas" {
    usecase "UC20 Alerta de estoque baixo\n(mensagem + sirene)" as UC20
    usecase "UC21 Alerta de validade" as UC21
  }
  package "Relatórios e Backup (opcionais)" {
    usecase "UC22 Relatório de vendas" as UC22
    usecase "UC23 Relatório do estoque" as UC23
    usecase "UC24 Relatório de itens em falta" as UC24
    usecase "UC25 Imprimir / salvar relatórios" as UC25
    usecase "UC26 Fazer backup" as UC26
  }
UC01 -- U
UC02 -- U
UC03 -- U
UC04 -- U
UC05 -- U
UC06 -- U
UC07 -- U
UC08 -- U
UC09 -- U
UC10 -- U
UC11 -- U
UC12 -- U
UC13 -- U
UC14 -- U
