@startuml
!include _estilo.iuml
title Diagrama de Classes - Domínio (pacote br.com.confeitasys.modelo)
hide circle
skinparam classAttributeIconSize 0

class Usuario <<Cadastro 1>> {
  - id : UUID
  - nome : String
  - senhaHash : String
  - criadoEm : LocalDateTime
  --
  + paraResposta() : UsuarioResposta
}

class Ingrediente <<Cadastro 2>> {
  - id : UUID
  - nome : String
  - unidade : String  {KG | L}
  - quantidade : double
  - custoUnitario : double
  - quantidadeAlerta : double
  - validade : LocalDate
  - atualizadoEm : LocalDateTime
  --
  + valorEmEstoque() : double
  + estoqueBaixo() : boolean
  + diasParaVencer() : Long
  + vencido() : boolean
  + venceLogo() : boolean
  + paraResposta() : IngredienteResposta
}

class Produto <<Cadastro 3>> {
  - id : UUID
  - nome : String
  - tamanho : String
  - recheio : String
  - precoVenda : double
  --
  + nomeCompleto() : String
  + custoEstimado() : double
  + paraResposta() : ProdutoResposta
}

class ItemReceita {
  - ingredienteId : UUID
  - ingredienteNome : String
  - unidade : String
  - quantidade : double
  - custoUnitario : double
  --
  + custoEstimado() : double
}

class Venda <<Movimento>> {
  - id : UUID
  - numero : int  {nº do pedido}
  - dataHora : LocalDateTime
  - produtoId : UUID
  - produtoNome : String
  - valorVenda : double
  --
  + custo() : double
  + lucro() : double
  + data() : String
  + hora() : String
  + paraResposta() : VendaResposta
}

class ItemVenda {
  - ingredienteId : UUID
  - nome : String
  - unidade : String
  - quantidade : double
  - custo : double
}

Produto "1" *-- "1..*" ItemReceita : receita >
ItemReceita "0..*" --> "1" Ingrediente : usa >
Venda "1" *-- "1..*" ItemVenda : itens >
ItemVenda "0..*" --> "0..1" Ingrediente : baixa no estoque >
Venda "0..*" --> "0..1" Produto : vende >
Usuario ..> Venda : registra >

note top of Venda
  id = chave (UUID, gerado pelo banco)
  numero = nº do pedido na nota (#0012)
end note

note bottom of Ingrediente
  estoqueBaixo() = quantidade <= quantidadeAlerta
  (a quantidade de alerta é definida pelo
  usuário para cada ingrediente)
end note
@enduml
