@startuml
!include _seq.iuml
title Sequência - Fazer Login (UC02)
actor Usuário as U
participant "Tela de Login\n(login.js → api.js)" as T
participant "AcessoControle\n(API REST)" as S
participant UsuarioServico as US
participant Senha
participant UsuarioDAO as D
database "PostgreSQL" as DB
U -> T : nome e senha
T -> S : API 1.1  POST /api/login\n→ AcessoControle.login()
alt bloqueado (5 erros seguidos)
  S --> T : 429 "Aguarde N segundos"
else caso contrário
  S -> US : login(nome, senha)
  US -> D : buscar()
  D -> DB : SELECT ... FROM usuario
  DB --> D : usuario (senha_hash)
  US -> Senha : conferir(senha, hash)
  Senha --> US : true / false
  alt senha correta
    S -> S : Sessoes.criar() → token
    S --> T : 200 {ok, token, nome}
    T -> T : guardar token (localStorage)
    T --> U : tela de Vendas
  else senha incorreta
    S -> S : Sessoes.registrarFalha()
    S --> T : 401 "Usuário ou senha incorretos"
    T --> U : mensagem de erro
  end
end
@enduml
