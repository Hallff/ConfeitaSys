@startuml
!include _seq.iuml
title Sequência - Consultar e Alterar Usuário (UC04, UC05)
actor Usuário as U
participant "Tela Conta\n(app.js → api.js)" as T
participant "UsuarioControle\n(API REST)" as S
participant UsuarioServico as US
participant Senha
participant UsuarioDAO as D
database "PostgreSQL" as DB
U -> T : clicar em "Conta"
T -> S : API 2.1  GET /api/usuario\n→ UsuarioControle.consultar()
S -> US : consultar()
US -> D : buscar()
D -> DB : SELECT
S --> T : {nome, criadoEm}
U -> T : novo nome / nova senha + senha atual
T -> S : API 2.2  PUT /api/usuario\n→ UsuarioControle.alterar()
S -> US : alterar(dados)
US -> D : buscar()
US -> Senha : conferir(senhaAtual, hash)
alt senha atual errada
  US --> S : RegraException
  S --> T : 400 "A senha atual está incorreta"
else ok
  opt nova senha informada
    US -> Senha : criptografar(novaSenha)
  end
  US -> D : alterar(usuario)
  D -> DB : UPDATE usuario
  S --> T : 200 {nome}
  T --> U : "Dados do usuário atualizados"
end
@enduml
