@startuml
!include _seq.iuml
title Sequência - Excluir Usuário (UC06)
actor Usuário as U
participant "Tela Conta" as T
participant Servidor as S
participant UsuarioServico as US
participant Senha
participant UsuarioDAO as D
database SQLite as DB
U -> T : senha + "Excluir usuário"
T --> U : pedir confirmação
U -> T : confirmar
T -> S : DELETE /api/usuario {senha}
S -> US : excluir(dados)
US -> D : buscar(con)
US -> Senha : conferir(senha, hash)
alt senha incorreta
  S --> T : 400 "Senha incorreta"
else ok
  US -> D : excluir(con, id)
  D -> DB : DELETE FROM usuario
  S -> S : encerrar sessões
  S --> T : 200 {ok}
  T --> U : tela de login (primeiro acesso)
end
@enduml
