@startuml
!include _seq.iuml
title Sequência - Consultar e Excluir Produto (UC12, UC14)
actor Usuário as U
participant "Tela Produtos" as T
participant Servidor as S
participant ProdutoServico as PS
participant ProdutoDAO as PD
database SQLite as DB
U -> T : abrir Produtos
T -> S : GET /api/produtos
S -> PS : listar()
PS -> PD : listar(con)
PD -> DB : SELECT produto + receita
S --> T : produtos com custo e lucro estimado
U -> T : lápis > Excluir > confirmar
T -> S : DELETE /api/produtos/{id}
S -> PS : excluir(id)
PS -> PD : excluir(con, id)
PD -> DB : DELETE FROM produto\n(receita apagada em cascata;\nvendas: produto_id = NULL)
S --> T : 200 {ok}
T --> U : "Produto excluído"
@enduml
