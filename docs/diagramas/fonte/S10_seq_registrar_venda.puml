@startuml
!include _seq.iuml
title Sequência - Registrar Venda com Baixa no Estoque (UC15)
actor Usuário as U
participant "Tela Vendas\n(app.js → api.js)" as T
participant "API REST\nIngredienteControle\nProdutoControle\nVendaControle\nAlertaControle" as S
participant VendaServico as VS
participant ProdutoDAO as PD
participant IngredienteDAO as ID
participant VendaDAO as VD
database "PostgreSQL" as DB
U -> T : botão + (centro superior)
T -> S : API 3.1  GET /api/ingredientes\n+ API 4.1  GET /api/produtos
S --> T : listas
U -> T : escolher produto
T -> T : preencher preço e receita;\ncalcular custo e lucro
U -> T : "Salvar venda"
T -> S : API 5.2  POST /api/vendas {produtoId, valorVenda, itens}\n→ VendaControle.registrar()
S -> VS : registrar(dados)
VS -> DB : BEGIN (transação)
VS -> PD : buscar(produtoId)
loop cada ingrediente
  VS -> ID : buscarParaAtualizar(id)\nSELECT ... FOR UPDATE (trava a linha)
  VS -> VS : quantidade necessária <= disponível?
end
alt estoque insuficiente
  VS -> DB : ROLLBACK
  S --> T : 400 "Estoque insuficiente de X"
  T --> U : mensagem de erro
else caso contrário
  loop cada ingrediente
    VS -> ID : movimentar(id, -quantidade)
    ID -> DB : UPDATE ingrediente SET quantidade = quantidade - ?
  end
  VS -> VD : inserir(venda)
  VD -> DB : INSERT venda + item_venda
  VS -> DB : COMMIT
  S --> T : 201 venda (nº do pedido, custo, lucro)
  T --> U : "Venda #0001 registrada"
  T -> S : API 6.1  GET /api/alertas\n→ AlertaControle.alertas()
  note right : se algum item chegou na\nqtd. de alerta: mensagem + SIRENE (S14)
end
@enduml
