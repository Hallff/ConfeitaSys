@startuml
!include _seq.iuml
title Sequência - Excluir Venda / Devolução (UC19)
actor Usuário as U
participant "Tela Vendas\n(app.js → api.js)" as T
participant "VendaControle\n(API REST)" as S
participant VendaServico as VS
participant IngredienteDAO as ID
participant VendaDAO as VD
database "PostgreSQL" as DB
U -> T : lápis > Excluir
T -> S : API 5.3  GET /api/vendas/{id}\n→ VendaControle.consultar()
S --> T : dados do pedido
T --> U : confirmar + "Devolver ingredientes ao estoque?"
U -> T : confirmar (com ou sem devolução)
T -> S : API 5.5  DELETE /api/vendas/{id}?devolver=sim|nao\n→ VendaControle.excluir()
S -> VS : excluir(id, devolver)
VS -> DB : BEGIN
VS -> VD : buscar(id)
opt devolver = sim
  loop cada item
    VS -> ID : movimentar(id, +quantidade)
  end
end
VS -> VD : excluir(id)
VD -> DB : DELETE FROM venda (itens em cascata)
VS -> DB : COMMIT
S --> T : 200 {ok}
T --> U : "Pedido excluído"
@enduml
